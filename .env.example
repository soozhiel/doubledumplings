# Full briefs are stored server-side in a protected Supabase table.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional durable rate limiting (falls back to per-instance limiting when unset).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional minimal notification only. The full brief is never placed in the email.
RESEND_API_KEY=
PRIVATE_BRIEF_NOTIFICATION_EMAIL=
PRIVATE_BRIEF_FROM_EMAIL=
